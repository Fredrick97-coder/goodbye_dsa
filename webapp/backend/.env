# Copy to .env and edit, or set these in your process manager / container.
# Every value shown is the default; nothing here is required for local dev.

# ---------------------------------------------------------------- environment
# dev  -> readable logs, /docs enabled, unsandboxed executor tolerated
# prod -> JSON logs, /docs disabled, refuses to start without a sandbox
FORGE_ENV=dev
# FORGE_DEBUG=0                      # never 1 in prod: it returns exception text
FORGE_TRUST_PROXY_HEADERS=1 
# --------------------------------------------------------------------- store
# FORGE_DB_PATH=/var/lib/forge/forge.db
# FORGE_DB_TIMEOUT=10                # seconds to wait on a locked database
# FORGE_DB_BUSY_RETRIES=4
# FORGE_DB_WAL=1                     # leave on; it is why concurrent reads work

# ------------------------------------------------------------------ sessions
# FORGE_SESSION_DAYS=30
# FORGE_COOKIE_NAME=forge_session
# FORGE_COOKIE_SAMESITE=lax          # strict is fine if the UI is same-origin
# FORGE_COOKIE_SECURE=auto           # auto = on unless plain-http localhost
# FORGE_COOKIE_DOMAIN=.forge.example # only if the UI is on a subdomain

# ------------------------------------------------------------------- hashing
# FORGE_SCRYPT_N=32768               # 2^15 = 32 MB, ~50 ms. Raise, never lower.

# -------------------------------------------------------------------- limits
# FORGE_RATE_WINDOW_SECONDS=900
# FORGE_RATE_MAX_ATTEMPTS=8
# FORGE_MAX_BODY_BYTES=1000000

# ---------------------------------------------------------------------- http
# REQUIRED in prod -- the app refuses to guess, because guessing means either a
# broken deployment or an origin allowlist wide enough to be no allowlist.
# FORGE_ALLOWED_ORIGINS=https://forge.example,https://www.forge.example
# FORGE_ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+\.forge\.example$
# FORGE_TRUST_PROXY_HEADERS=1        # ONLY behind a proxy that sets XFF itself

# ----------------------------------------------------------------- execution
# auto picks the strongest available: docker > seatbelt > local
FORGE_EXECUTOR=auto
# FORGE_ALLOW_UNSAFE_EXECUTOR=0      # 1 = "I accept unsandboxed execution"
# FORGE_EXEC_WALL_SECONDS=10
# FORGE_EXEC_CPU_SECONDS=5
# FORGE_EXEC_MEMORY_MB=512
# FORGE_EXEC_MAX_SOURCE_BYTES=200000
# FORGE_EXEC_MAX_CONCURRENT=4        # simultaneous submissions; each may use
                                     # up to EXEC_MEMORY_MB, so size for the host
# FORGE_DOCKER_IMAGE=forge-runner:latest
# FORGE_DOCKER_BINARY=docker          # e.g. podman, if that is what you run
# FORGE_DOCKER_PIDS_LIMIT=64

# ------------------------------------------------------------------- logging
# FORGE_LOG_LEVEL=INFO
# FORGE_LOG_JSON=1                   # defaults on in prod
# FORGE_LOG_REQUESTS=1

# --------------------------------------------------------------- curriculum
# FORGE_PYTHON_ROOT=/srv/forge/python
